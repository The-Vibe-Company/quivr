{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quivr.invalid/contracts/plugins/v0/authentication-fixture.schema.json",
  "title": "Engine authentication fixtures",
  "description": "Normative authentication probes used by the Contract Runner. The plugin audience placeholder resolves to the tested plugin id; other audiences and the other-plugin claim placeholder resolve to a distinct id. Tokens bind GET /v0/discovery?source=engine and the exact body. Optional claim, lifetime, algorithm and JSON encoding edits are applied before signing. Unsigned omits the token; forged changes a signature byte.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "audience",
          "issued_seconds_ago",
          "body",
          "sent_body",
          "expected_status"
        ],
        "properties": {
          "name": {
            "enum": [
              "valid",
              "expired",
              "wrong-audience",
              "tampered",
              "unsigned",
              "forged",
              "wrong-plugin-id",
              "wrong-route",
              "wrong-method",
              "future-iat",
              "overlong-lifetime",
              "alg-none",
              "utf16"
            ]
          },
          "audience": {
            "type": "string",
            "minLength": 1
          },
          "issued_seconds_ago": {
            "type": "integer",
            "minimum": -3600,
            "maximum": 3600
          },
          "body": {
            "type": "string",
            "const": "{}"
          },
          "sent_body": {
            "type": "string"
          },
          "expected_status": {
            "enum": [
              200,
              401
            ]
          },
          "claims": {
            "type": "object",
            "additionalProperties": false,
            "description": "Signed claim replacements; other-plugin resolves to an id distinct from the tested plugin.",
            "properties": {
              "plugin_id": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "enum": [
                  "GET",
                  "POST"
                ]
              },
              "target": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "lifetime_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600,
            "default": 60,
            "description": "Token lifetime before signature generation, including intentionally invalid lifetimes."
          },
          "algorithm": {
            "enum": [
              "HS256",
              "none"
            ],
            "default": "HS256"
          },
          "json_encoding": {
            "enum": [
              "utf-8",
              "utf-16"
            ],
            "default": "utf-8",
            "description": "Encoding of both signed JSON parts; UTF-16 includes a little-endian BOM."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "name": {
                  "const": "valid"
                }
              }
            },
            "then": {
              "properties": {
                "expected_status": {
                  "const": 200
                }
              }
            },
            "else": {
              "properties": {
                "expected_status": {
                  "const": 401
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {
                  "enum": [
                    "wrong-audience"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "audience": {
                  "not": {
                    "const": "plugin"
                  }
                }
              }
            },
            "else": {
              "properties": {
                "audience": {
                  "const": "plugin"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {
                  "enum": [
                    "expired"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "issued_seconds_ago": {
                  "minimum": 61
                }
              }
            },
            "else": {
              "properties": {
                "issued_seconds_ago": {
                  "maximum": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {
                  "enum": [
                    "future-iat"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "issued_seconds_ago": {
                  "maximum": -1
                }
              }
            },
            "else": {
              "properties": {
                "issued_seconds_ago": {
                  "minimum": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {
                  "enum": [
                    "tampered"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "sent_body": {
                  "const": "{ }"
                }
              }
            },
            "else": {
              "properties": {
                "sent_body": {
                  "const": "{}"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {
                  "enum": [
                    "wrong-plugin-id",
                    "wrong-route",
                    "wrong-method"
                  ]
                }
              }
            },
            "then": {
              "properties": {},
              "required": [
                "claims"
              ]
            },
            "else": {
              "properties": {
                "claims": false
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {
                  "const": "wrong-plugin-id"
                }
              }
            },
            "then": {
              "properties": {
                "claims": {
                  "const": {
                    "plugin_id": "other-plugin"
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {
                  "const": "wrong-route"
                }
              }
            },
            "then": {
              "properties": {
                "claims": {
                  "const": {
                    "target": "/v0/discovery?source=other"
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {
                  "const": "wrong-method"
                }
              }
            },
            "then": {
              "properties": {
                "claims": {
                  "const": {
                    "method": "POST"
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {
                  "enum": [
                    "overlong-lifetime"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "lifetime_seconds": {
                  "minimum": 61
                }
              },
              "required": [
                "lifetime_seconds"
              ]
            },
            "else": {
              "properties": {
                "lifetime_seconds": {
                  "maximum": 60
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {
                  "not": {
                    "enum": [
                      "future-iat",
                      "overlong-lifetime"
                    ]
                  }
                }
              }
            },
            "then": {
              "properties": {
                "lifetime_seconds": {
                  "const": 60
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {
                  "enum": [
                    "alg-none"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "algorithm": {
                  "const": "none"
                }
              },
              "required": [
                "algorithm"
              ]
            },
            "else": {
              "properties": {
                "algorithm": {
                  "const": "HS256"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {
                  "enum": [
                    "utf16"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "json_encoding": {
                  "const": "utf-16"
                }
              },
              "required": [
                "json_encoding"
              ]
            },
            "else": {
              "properties": {
                "json_encoding": {
                  "const": "utf-8"
                }
              }
            }
          }
        ]
      },
      "maxItems": 13,
      "allOf": [
        {
          "contains": {
            "properties": {
              "name": {
                "const": "valid"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "expired"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "wrong-audience"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "tampered"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "unsigned"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "forged"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "wrong-plugin-id"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "wrong-route"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "wrong-method"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "future-iat"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "overlong-lifetime"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "alg-none"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "utf16"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ],
      "description": "Exactly 13 items; each named case appears exactly once. Every probe changes only its named authentication condition."
    }
  }
}
