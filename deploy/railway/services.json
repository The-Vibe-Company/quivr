{
  "postgres": {
    "image": "postgres:17.11-alpine@sha256:18cfe3ef5e6815560c98237d6216d1e5119702fb0f3894c8785dd58b8bbe5d73",
    "volume": "/data",
    "variables": {"POSTGRES_USER": "quivr", "POSTGRES_DB": "quivr", "PGDATA": "/data/pgdata"}
  },
  "temporal": {"dockerfile": "temporal", "volume": "/data"},
  "seaweed": {"dockerfile": "seaweed", "volume": "/data"},
  "weaviate": {
    "image": "cr.weaviate.io/semitechnologies/weaviate:1.37.15@sha256:cede92f9f43f9b4be25a9f453e756173bbe171d2e88210a0e5b7ab72e8b96d96",
    "volume": "/var/lib/weaviate",
    "healthcheck": "/v1/meta",
    "variables": {"PORT": "8080", "AUTHENTICATION_ANONYMOUS_ACCESS_ENABLED": "true", "AUTOSCHEMA_ENABLED": "false", "CLUSTER_HOSTNAME": "quivr-demo", "DEFAULT_VECTORIZER_MODULE": "none", "PERSISTENCE_DATA_PATH": "/var/lib/weaviate"}
  },
  "tei": {"dockerfile": "tei", "healthcheck": "/health", "variables": {"PORT": "80", "HF_HUB_OFFLINE": "1"}},
  "api": {"dockerfile": "core", "healthcheck": "/readyz", "variables": {"PORT": "8081", "QUIVR_ROLE": "api"}},
  "worker": {"dockerfile": "core", "healthcheck": "/readyz", "variables": {"PORT": "8081", "QUIVR_ROLE": "worker"}},
  "web": {"dockerfile": "web", "healthcheck": "/healthz", "variables": {"PORT": "3000", "HOST": "0.0.0.0", "DEMO_SECURE_COOKIE": "true", "QUIVR_API_URL": "http://api.railway.internal:8080"}}
}
