    },
    {
      "source": "/plugins/rss",
      "destination": "/plugins/catalog"
    },
    {
      "source": "/plugins/x-list",
      "destination": "/plugins/catalog"
    },
    {
      "source": "/sdks/go",
      "destination": "/plugins/write-a-connector"
    },
    {
      "source": "/sdks/python",
      "destination": "/plugins/first-plugin"
    },
    {
      "source": "/contracts/plugins/v0",
      "destination": "/reference/plugin-protocol"
    },
    {
      "source": "/contracts/http/v0",
      "destination": "/api-reference/overview"
    },
    {
      "source": "/reference/http-api",
