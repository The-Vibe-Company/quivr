{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Quivr",
  "description": "An open-source engine that turns continuous content streams into search and alerts.",
  "colors": {
    "primary": "#5b3fd6",
    "light": "#b29aff",
    "dark": "#4b31be"
  },
  "api": {
    "playground": {
      "display": "interactive"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart",
              "concepts"
            ]
          },
          {
            "group": "Plugins",
            "pages": [
              "plugins/overview",
              "plugins/types",
              "plugins/first-plugin",
              {
                "group": "Write a plugin",
                "pages": [
                  "plugins/write-a-connector",
                  "plugins/push-source",
                  "plugins/write-an-ingestion-plugin",
                  "plugins/write-a-retrieval-plugin",
                  "plugins/write-an-alert-rule"
                ]
              },
              "plugins/pin",
              "plugins/upgrade-a-plugin",
              "plugins/switch-plugins-without-restarting",
              "plugins/backfill-a-vector-space",
              "plugins/reprocess-quarantined-versions",
              "plugins/catalog",
              "guides/rerank-with-jev"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/add-content",
              "guides/search",
              "guides/keyword-alerts",
              "guides/described-alerts",
              {
                "group": "Collect from sources",
                "pages": [
                  "guides/connectors",
                  "guides/rss",
                  "guides/microsoft-365",
                  "guides/x"
                ]
              },
              "guides/ai-agents"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "HTTP API",
            "pages": [
              "api-reference/overview"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": "openapi.yaml"
          },
          {
            "group": "Command line",
            "pages": [
              "reference/cli",
              "reference/mcp"
            ]
          },
          {
            "group": "Plugins",
            "pages": [
              "reference/plugin-manifest",
              "reference/plugin-protocol"
            ]
          },
          {
            "group": "Deployment",
            "pages": [
              "reference/configuration"
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/first-search",
      "destination": "/quickstart"
    },
    {
      "source": "/what-quivr-can-do",
      "destination": "/"
    },
    {
      "source": "/api-walkthrough",
      "destination": "/guides/add-content"
    },
    {
      "source": "/connect-an-ai-agent",
      "destination": "/guides/ai-agents"
    },
    {
      "source": "/keyword-alerts",
      "destination": "/guides/keyword-alerts"
    },
    {
      "source": "/described-alerts",
      "destination": "/guides/described-alerts"
    },
    {
      "source": "/connectors",
      "destination": "/guides/connectors"
    },
    {
      "source": "/connectors/rss",
      "destination": "/guides/rss"
    },
    {
      "source": "/connectors/microsoft-365",
      "destination": "/guides/microsoft-365"
    },
    {
      "source": "/connectors/x",
      "destination": "/guides/x"
    },
    {
      "source": "/connectors/x-webhooks",
      "destination": "/guides/x"
    },
    {
      "source": "/plugins/write-a-normalizer",
      "destination": "/plugins/first-plugin"
    },
    {
      "source": "/plugins/run-a-connector-plugin",
      "destination": "/plugins/pin"
    },
    {
      "source": "/plugins/alerts",
      "destination": "/plugins/catalog"
    },
    {
      "source": "/plugins/core-ingest",
