    {
      "source": "/agents",
      "destination": "/"
    },
    {
      "source": "/context",
      "destination": "/concepts"
    },
    {
      "source": "/dated",
      "destination": "/"
    },
    {
      "source": "/deploy/railway",
      "destination": "/"
    },
    {
      "source": "/quivr-search",
      "destination": "/"
    },
    {
      "source": "/quivr-v2-local-harness",
      "destination": "/"
    },
    {
      "source": "/quivr-v2-remaining-limits",
      "destination": "/"
    },
    {
      "source": "/runnable-guides",
      "destination": "/"
    },
    {
      "source": "/tests/acceptance",
      "destination": "/"
    },
    {
      "source": "/third_party",
      "destination": "/"
    }
  ]
}
