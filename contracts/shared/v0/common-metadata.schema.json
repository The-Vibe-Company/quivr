{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quivr.invalid/contracts/shared/v0/common-metadata.schema.json",
  "$vocabulary": {
    "https://json-schema.org/draft/2020-12/vocab/core": true,
    "https://json-schema.org/draft/2020-12/vocab/applicator": true,
    "https://json-schema.org/draft/2020-12/vocab/validation": true,
    "https://json-schema.org/draft/2020-12/vocab/format-annotation": true,
    "https://json-schema.org/draft/2020-12/vocab/format-assertion": true
  },
  "title": "Quivr common metadata",
  "description": "Optional source metadata available to every connector and normalizer.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "language": {"type": "string", "maxLength": 200},
    "published_at": {"type": "string", "format": "date-time", "maxLength": 200},
    "source_type": {"type": "string", "maxLength": 200},
    "source": {"type": "string", "maxLength": 200},
    "author": {
      "type": "array",
      "maxItems": 50,
      "items": {"type": "string", "maxLength": 200}
    },
    "subjects": {
      "type": "array",
      "maxItems": 50,
      "items": {"type": "string", "maxLength": 200}
    },
    "tags": {
      "type": "array",
      "maxItems": 50,
      "items": {"type": "string", "maxLength": 200}
    },
    "country": {
      "type": "array",
      "maxItems": 50,
      "items": {"type": "string", "maxLength": 200}
    },
    "place": {
      "type": "array",
      "maxItems": 50,
      "items": {"type": "string", "maxLength": 200}
    }
  }
}
