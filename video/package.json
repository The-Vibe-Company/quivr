{
  "name": "@quivr-v2/architecture-video",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "render": "remotion render src/index.ts QuivrExplainer ../docs/assets/quivr-v2-explainer.mp4 --codec=h264 --crf=18",
    "render:loop": "remotion render src/index.ts QuivrReadmeLoop ../docs/assets/quivr-v2-explainer-loop.gif --codec=gif --every-nth-frame=2",
    "render:poster": "remotion still src/index.ts QuivrExplainer ../docs/assets/quivr-v2-explainer-poster.png --frame=260"
  },
  "dependencies": {
    "@remotion/transitions": "4.0.520",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.520"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.520",
    "@types/node": "24.3.0",
    "typescript": "7.0.2"
  }
}
